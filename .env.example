# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public app URL, used as the allowed origin in production.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Replace with a random value of at least 32 characters.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
SESSION_TTL_SECONDS="3600"

# PostgreSQL. Create this database/user locally, then run `npm run db:migrate`.
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/kare_campus_db"
# Optional; use a separate disposable database for the destructive integration test suite.
TEST_DATABASE_URL=""
PG_POOL_MAX="10"
# Use "require" when the PostgreSQL provider requires TLS. Certificate checks stay enabled.
PGSSLMODE=""

# Optional exact origin of a separate frontend. Same-origin is used by default.
FRONTEND_ORIGIN="http://localhost:3000"
TRUST_PROXY="false"
COOKIE_SAME_SITE="Lax"

# One-time management account setup key. Generate a random secret of at least 32 characters.
MANAGEMENT_BOOTSTRAP_KEY=""

# Twilio SMS. Leave SMS_PROVIDER empty in development to record non-delivered simulations.
SMS_PROVIDER=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Optional real contact numbers for seeded worker records; use +91XXXXXXXXXX format.
WORKER_ELECTRICAL_PHONE=""
WORKER_PLUMBING_PHONE=""
WORKER_CLEANING_PHONE=""
WORKER_NETWORK_PHONE=""
WORKER_HVAC_PHONE=""
WORKER_SAFETY_PHONE=""
